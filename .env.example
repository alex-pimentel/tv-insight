# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
APP_PORT=7777
APP_ENV=production
LOG_LEVEL=INFO

# Comma separated list of allowed origins for the browser. "*" during local use.
CORS_ALLOW_ORIGINS=*

# ---------------------------------------------------------------------------
# Database (container: db)
# ---------------------------------------------------------------------------
POSTGRES_USER=tvinsight
POSTGRES_PASSWORD=tvinsight
POSTGRES_DB=tvinsight
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Overrides the assembled URL below when set.
DATABASE_URL=

# ---------------------------------------------------------------------------
# TVMaze public API
# ---------------------------------------------------------------------------
TVMAZE_BASE_URL=https://api.tvmaze.com
TVMAZE_TIMEOUT_SECONDS=5
TVMAZE_CACHE_TTL_SECONDS=300
TVMAZE_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# AI insights
# ---------------------------------------------------------------------------
# Ordered, comma separated fallback chain. The first provider that answers wins.
# Known values: huggingface, openrouter, heuristic
# Default: primary model, then the local heuristic process. Insert "openrouter"
# to opt into a second model tier.
AI_PROVIDER_ORDER=huggingface,heuristic
AI_TIMEOUT_SECONDS=20
AI_MAX_COMMENTS=12
AI_MAX_SUMMARY_CHARS=1200

# Regenerate a stored insight as soon as this many new comments exist.
# 0 (default) = regenerate on EVERY request. The stored insight is then used only
# when the model providers fail ("last known good answer"). Set to 1 to restore the
# earlier cost-control rule: "as a simple test, consider 1 comment is enough".
AI_INSIGHT_COMMENT_THRESHOLD=0

# In-process memoisation of identical prompts (absorbs bursts).
# 0 (default) = disabled, so every request really reaches the provider.
AI_INSIGHT_CACHE_TTL_SECONDS=0

# HuggingFace Inference Providers (free tier). Leave the token empty to skip it.
# The router's OpenAI-compatible endpoint is used (not the task endpoint, which is
# pinned to a single provider). List available model ids with:
#   curl -H "Authorization: Bearer $HUGGINGFACE_API_TOKEN" \
#        https://router.huggingface.co/v1/models
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1

# OpenRouter (OpenAI compatible). Leave the key empty to skip it.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:7777
OPENROUTER_APP_NAME=tv-insight
